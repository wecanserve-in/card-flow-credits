# Copy to .env for local runs. On Cloud Run, set these as environment variables instead.

# Razorpay (use rzp_live_... keys for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Admin. Locally, point to the service account JSON.
# On Cloud Run leave the path unset; the service's own identity is used.
FIREBASE_PROJECT_ID=card-flow-6da93
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Cloudflare R2 (profile photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
