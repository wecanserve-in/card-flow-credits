{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      // @firebase/auth lists its generic "types" export condition before
      // "react-native", so TypeScript never picks the RN typings (which
      // declare getReactNativePersistence). Metro resolves the RN build at
      // runtime; this mapping only makes the type checker match it.
      "@firebase/auth": [
        "./node_modules/@firebase/auth/dist/rn/index.rn.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
